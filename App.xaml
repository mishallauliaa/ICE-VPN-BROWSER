<Application x:Class="ICEBrowser.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#0B1220"/>
  <SolidColorBrush x:Key="Panel" Color="#111C2E"/>
  <SolidColorBrush x:Key="Accent" Color="#28A7F0"/>
  <SolidColorBrush x:Key="TextMain" Color="#EAF2FF"/>
  <SolidColorBrush x:Key="TextMuted" Color="#91A4BF"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#1B2B43"/>
   <Setter Property="Foreground" Value="#EAF2FF"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
 </Application.Resources>
</Application>
