<Window x:Class="ICEBrowser.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ICE BROWSER" Height="820" Width="1360" MinHeight="560" MinWidth="900"
 WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="44"/><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#0E192A">
   <DockPanel Margin="12,0">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
     <TextBlock Text="❄" Foreground="#42B8FF" FontSize="23" Margin="0,0,9,0"/>
     <TextBlock Text="ICE BROWSER" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
     <TextBlock Text="  FAST • PRIVATE • SIMPLE • v1.4" Foreground="#8297B4" FontSize="10" VerticalAlignment="Center" Margin="12,3,0,0"/>
    </StackPanel>
    <Border DockPanel.Dock="Right" Background="#17263A" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <Ellipse x:Name="VpnDot" Width="8" Height="8" Fill="#D99A36" Margin="0,0,7,0"/>
      <TextBlock x:Name="VpnLabel" Text="VPN DISCONNECTED" Foreground="#D8E5F7" FontSize="11" VerticalAlignment="Center"/>
      <Button x:Name="VpnButton" Content="CONNECT VPN" Margin="12,0,0,0" Padding="12,5" Background="#147BC0" Click="VpnButton_Click"/>
     </StackPanel>
    </Border>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Background="#101B2C">
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel x:Name="TabsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0"/>
   </ScrollViewer>
  </Border>
  <Border Grid.Row="2" Background="#142137" Padding="9,6">
   <DockPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
     <Button Content="←" Width="38" Click="Back_Click"/>
     <Button Content="→" Width="38" Click="Forward_Click"/>
     <Button Content="↻" Width="38" Click="Refresh_Click"/>
     <Button Content="⌂" Width="38" Click="Home_Click"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button Content="☆" Width="38" ToolTip="Bookmark" Click="Bookmark_Click"/>
     <Button Content="AdBlock ON" x:Name="AdBlockButton" Click="AdBlock_Click"/>
     <Button Content="Private" Click="PrivateTab_Click"/>
     <Button Content="Downloads" Click="Downloads_Click"/>
     <Button Content="Settings" Click="Settings_Click"/>
     <Button Content="＋ Tab" Click="NewTab_Click"/>
    </StackPanel>
    <TextBox x:Name="AddressBox" Height="34" VerticalContentAlignment="Center" Padding="12,0"
     Background="#0B1423" Foreground="#EAF2FF" BorderThickness="0" FontSize="14"
     KeyDown="AddressBox_KeyDown"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="3" x:Name="BrowserHost" Background="White"/>
  <Border Grid.Row="4" Background="#0E192A" Padding="10,2">
   <DockPanel>
    <TextBlock Text="ICE BROWSER" Foreground="#7890AF" FontSize="10"/>
    <TextBlock x:Name="SpeedText" Text="Load: --" Foreground="#7890AF" FontSize="10" DockPanel.Dock="Right" Margin="12,0,0,0"/>
    <TextBlock x:Name="StatusText" Text="Ready" Foreground="#7890AF" FontSize="10" DockPanel.Dock="Right"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
